{
  "$schema": "https://raw.githubusercontent.com/T-Auto/dsh-std/main/packages/manifest/schema/dsh-plugin-0.15.schema.json",
  "manifestVersion": "0.15",
  "id": "terra.endfield.perlica-ding",
  "name": "Perlica Ding",
  "version": "0.3.0",
  "facets": {
    "host": {
      "entry": "lib/host/facet-std.mjs",
      "apiVersion": "v1alpha1"
    }
  },
  "requires": {
    "contracts": [
      {
        "apiVersion": "storage.dsh/v1alpha1",
        "kind": "LocalStorage",
        "optional": true,
        "fallback": "The DSH native storage domain carries the volume; with neither available the volume does not survive a restart."
      }
    ]
  },
  "permissions": [
    {
      "name": "storage.local.read",
      "scope": "terra.endfield.perlica-ding",
      "reason": "Read the saved notification volume."
    },
    {
      "name": "storage.local.write",
      "scope": "terra.endfield.perlica-ding",
      "reason": "Save the notification volume."
    }
  ],
  "contributes": {
    "x-browser-ui": [
      {
        "id": "terra.endfield.perlica-ding.settings",
        "apiVersion": "browser.ui.dsh/v1alpha1",
        "kind": "LocalModule",
        "name": "browser",
        "spec": {
          "module": "lib/browser/index.js"
        }
      }
    ]
  }
}
